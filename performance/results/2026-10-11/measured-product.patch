diff --git a/mc/cmd/mc/read_deadline.go b/mc/cmd/mc/read_deadline.go
new file mode 100644
index 00000000..de9cc3fa
--- /dev/null
+++ b/mc/cmd/mc/read_deadline.go
@@ -0,0 +1,144 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strconv"
+	"time"
+
+	"mc/verbs"
+)
+
+const maxReadDuration = 15 * time.Second
+const unconfirmedReadExitCode = 125
+
+type readInvocation struct {
+	context     context.Context
+	deadline    time.Time
+	unconfirmed bool
+}
+
+// One process executes one command. Nested host reads retain its deadline.
+var currentRead *readInvocation
+
+func deadlineReadAllowed(args []string) bool {
+	if len(args) < 2 {
+		return false
+	}
+	switch args[0] + " " + args[1] {
+	case "task list", "task get", "project list", "packet list", "lease list",
+		"settings get", "pause status", "run list", "run customization",
+		"wiki-state list", "collie list", "collie history", "activity list",
+		"board history-report", "outbox poll", "system status", "system diagnostics",
+		"__system-state status", "__system-state diagnostics":
+		return true
+	}
+	return false
+}
+
+func parseReadCommand(args []string) (time.Time, []string, error) {
+	if len(args) < 6 || args[0] != "__read" || args[1] != "--deadline-unix-ms" || args[3] != "--" {
+		return time.Time{}, nil, fmt.Errorf("The read requires an absolute deadline and a command.")
+	}
+	deadline, err := strconv.ParseInt(args[2], 10, 64)
+	if err != nil || deadline <= 0 {
+		return time.Time{}, nil, fmt.Errorf("The read deadline is invalid.")
+	}
+	inner := args[4:]
+	if !deadlineReadAllowed(inner) {
+		return time.Time{}, nil, fmt.Errorf("The command does not support a read deadline.")
+	}
+	return time.UnixMilli(deadline), inner, nil
+}
+
+func runReadCommand(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	deadline, inner, err := parseReadCommand(args)
+	if err != nil {
+		return writeVerbError(stdout, stderr, verbs.Usagef("%v", err))
+	}
+	return runWithinReadDeadline(deadline, func() int {
+		if shouldDelegateToHelper() {
+			id, err := verbs.LoadIdentity()
+			if err != nil {
+				return writeVerbError(stdout, stderr, err)
+			}
+			if err := verbs.RequireHostScope(id, "bounded read"); err != nil {
+				return writeVerbError(stdout, stderr, err)
+			}
+		} else if !privateHelperScopeOK() {
+			return writeVerbError(stdout, stderr, verbs.Domainf("The read wrapper requires the host or the fixed helper scope."))
+		}
+		return run(inner, stdin, stdout, stderr)
+	})
+}
+
+func readDeadlineBudget(deadline, now time.Time) time.Duration {
+	remaining := deadline.Sub(now)
+	if remaining > maxReadDuration {
+		return maxReadDuration
+	}
+	return remaining
+}
+
+func runWithinReadDeadline(deadline time.Time, action func() int) int {
+	now := time.Now()
+	budget := readDeadlineBudget(deadline, now)
+	if budget <= 0 {
+		return privateHelperTimeoutExitCode
+	}
+	deadline = now.Add(budget)
+	parent := context.Background()
+	previous := currentRead
+	if previous != nil {
+		parent = previous.context
+		if previous.deadline.Before(deadline) {
+			deadline = previous.deadline
+		}
+	}
+	ctx, cancel := context.WithDeadline(parent, deadline)
+	defer cancel()
+	// The container timer remains active after its Docker client disconnects.
+	// The local cap bounds clock differences between the Mac and the virtual machine.
+	timer := time.AfterFunc(time.Until(deadline), func() { os.Exit(privateHelperTimeoutExitCode) })
+	defer timer.Stop()
+	invocation := &readInvocation{context: ctx, deadline: deadline}
+	currentRead = invocation
+	defer func() {
+		if previous != nil && invocation.unconfirmed {
+			previous.unconfirmed = true
+		}
+		currentRead = previous
+	}()
+	if ctx.Err() != nil {
+		return privateHelperTimeoutExitCode
+	}
+	code := action()
+	if ctx.Err() != nil {
+		return privateHelperTimeoutExitCode
+	}
+	if code == 0 && invocation.unconfirmed {
+		return unconfirmedReadExitCode
+	}
+	return code
+}
+
+func readCommand(name string, args ...string) *exec.Cmd {
+	if currentRead == nil {
+		return exec.Command(name, args...)
+	}
+	return exec.CommandContext(currentRead.context, name, args...)
+}
+
+func delegatedReadArgs(args []string) []string {
+	if currentRead == nil {
+		return args
+	}
+	return readArgsAtDeadline(args, currentRead.deadline)
+}
+
+func readArgsAtDeadline(args []string, deadline time.Time) []string {
+	return append([]string{"__read", "--deadline-unix-ms", strconv.FormatInt(deadline.UnixMilli(), 10), "--"}, args...)
+}
diff --git a/mc/cmd/mc/read_deadline_test.go b/mc/cmd/mc/read_deadline_test.go
new file mode 100644
index 00000000..e51faf12
--- /dev/null
+++ b/mc/cmd/mc/read_deadline_test.go
@@ -0,0 +1,165 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+func TestReadDeadlineAcceptsExactReadCommand(t *testing.T) {
+	deadline := time.Now().Add(time.Second).UnixMilli()
+	want := []string{"task", "list", "--project", "project-1", "--limit", "20"}
+	args := append([]string{"__read", "--deadline-unix-ms", strconv.FormatInt(deadline, 10), "--"}, want...)
+	gotDeadline, gotArgs, err := parseReadCommand(args)
+	if err != nil || gotDeadline.UnixMilli() != deadline || !reflect.DeepEqual(gotArgs, want) {
+		t.Fatalf("parsed deadline = %v, command = %v, error = %v", gotDeadline, gotArgs, err)
+	}
+}
+
+func TestReadDeadlineRejectsWritesAndUnknownCommands(t *testing.T) {
+	for _, command := range [][]string{
+		{"task", "create"}, {"project", "register"}, {"pause", "all"},
+		{"settings", "set"}, {"outbox", "ack"}, {"system", "probe"},
+		{"doctor"}, {"config", "get"}, {"__system-state", "record"},
+	} {
+		t.Run(strings.Join(command, "_"), func(t *testing.T) {
+			args := append([]string{"__read", "--deadline-unix-ms", strconv.FormatInt(time.Now().Add(time.Second).UnixMilli(), 10), "--"}, command...)
+			var stdout, stderr bytes.Buffer
+			code := run(args, privateExpiredDeadlineReader{t}, &stdout, &stderr)
+			if code != 2 || !strings.Contains(stdout.String(), "error") {
+				t.Fatalf("write refusal = %d, stdout = %q, stderr = %q", code, stdout.String(), stderr.String())
+			}
+		})
+	}
+}
+
+func TestReadDeadlineRejectsInvalidEnvelope(t *testing.T) {
+	for _, args := range [][]string{
+		{"__read"},
+		{"__read", "--deadline-unix-ms", "0", "--", "task", "list"},
+		{"__read", "--deadline-unix-ms", "abc", "--", "task", "list"},
+		{"__read", "--deadline-unix-ms", "123", "task", "list"},
+		{"__read", "--deadline", "123", "--", "task", "list"},
+	} {
+		if _, _, err := parseReadCommand(args); err == nil {
+			t.Fatalf("accepted invalid read envelope: %q", args)
+		}
+	}
+}
+
+func TestReadDeadlineExpiresBeforeAction(t *testing.T) {
+	code := runWithinReadDeadline(time.Now().Add(-time.Second), func() int {
+		t.Fatal("an expired read reached the command body")
+		return 99
+	})
+	if code != privateHelperTimeoutExitCode {
+		t.Fatalf("expired read exit = %d", code)
+	}
+}
+
+func TestReadDeadlineCapsClockDifference(t *testing.T) {
+	now := time.Now()
+	if got := readDeadlineBudget(now.Add(time.Hour), now); got != maxReadDuration {
+		t.Fatalf("clock difference budget = %s, want %s", got, maxReadDuration)
+	}
+	if got := readDeadlineBudget(now.Add(3*time.Second), now); got != 3*time.Second {
+		t.Fatalf("remaining budget = %s, want 3s", got)
+	}
+}
+
+func TestReadDeadlineNestedReadKeepsParentDeadline(t *testing.T) {
+	previous := currentRead
+	synctest.Test(t, func(t *testing.T) {
+		deadline := time.Now().Add(time.Second)
+		code := runWithinReadDeadline(deadline, func() int {
+			parent := currentRead
+			childCode := runWithinReadDeadline(time.Now().Add(time.Hour), func() int {
+				if !currentRead.deadline.Equal(deadline) {
+					t.Fatalf("nested deadline = %s, want %s", currentRead.deadline, deadline)
+				}
+				args := delegatedReadArgs([]string{"project", "list"})
+				if args[2] != strconv.FormatInt(deadline.UnixMilli(), 10) {
+					t.Fatalf("Docker received a different deadline: %v", args)
+				}
+				return 0
+			})
+			if currentRead != parent {
+				t.Fatal("the nested read did not restore its parent context")
+			}
+			return childCode
+		})
+		if code != 0 {
+			t.Fatalf("read exit = %d", code)
+		}
+	})
+	if currentRead != previous {
+		t.Fatal("the read left its deadline on another command")
+	}
+}
+
+func TestReadDeadlineCancelsHostCommandBeforeSpawn(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	previous := currentRead
+	currentRead = &readInvocation{context: ctx, deadline: time.Now().Add(time.Second)}
+	t.Cleanup(func() { currentRead = previous })
+	if err := readCommand("/bin/sh", "-c", "exit 99").Run(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled host command returned %v", err)
+	}
+}
+
+func TestReadDeadlinePreservesUnconfirmedNestedRead(t *testing.T) {
+	code := runWithinReadDeadline(time.Now().Add(time.Second), func() int {
+		inner := runWithinReadDeadline(time.Now().Add(time.Second), func() int {
+			currentRead.unconfirmed = true
+			return 0
+		})
+		if inner != unconfirmedReadExitCode {
+			t.Fatalf("nested unconfirmed read exit = %d", inner)
+		}
+		return 0 // System status can still return a partial result.
+	})
+	if code != unconfirmedReadExitCode {
+		t.Fatalf("unconfirmed read exit = %d", code)
+	}
+}
+
+func TestReadDeadlineTerminatesBlockedContainerCommand(t *testing.T) {
+	if os.Getenv("MC_TEST_READ_SELF_DEADLINE") == "1" {
+		synctest.Test(t, func(t *testing.T) {
+			reader, writer := io.Pipe()
+			defer reader.Close()
+			defer writer.Close()
+			const budget = 20 * time.Millisecond
+			go func() {
+				code := runWithinReadDeadline(time.Now().Add(budget), func() int {
+					fmt.Fprintln(os.Stdout, "The container command started.")
+					_, _ = io.ReadAll(reader)
+					return 99
+				})
+				fmt.Fprintf(os.Stderr, "The container command returned %d.\n", code)
+				os.Exit(99)
+			}()
+			synctest.Wait()
+			time.Sleep(budget - time.Nanosecond)
+			fmt.Fprintln(os.Stdout, "The container command remains alive before its deadline.")
+			time.Sleep(time.Nanosecond)
+			synctest.Wait()
+			t.Fatal("the container command remains alive at its deadline")
+		})
+		return
+	}
+	output := privateHelperDeadlineProcess(t, "MC_TEST_READ_SELF_DEADLINE")
+	if !strings.Contains(output, "The container command remains alive before its deadline.") {
+		t.Fatalf("the container command ended before its deadline: %s", output)
+	}
+}
