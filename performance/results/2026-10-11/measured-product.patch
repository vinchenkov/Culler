+        writeFileSync(value.file("release"), "release\n");
+        firstController.abort();
+        secondController.abort();
+        await settles(first);
+      }
+    });
+  });
+
+  test("An aborted expired context preserves the plain write command", async () => {
+    await fixture(`printf '%s\\n' "$@" > arguments\ncat`, async (value) => {
+      const records: McCompletionRecord[] = [];
