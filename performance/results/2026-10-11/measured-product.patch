+import { describe, expect, test } from "bun:test";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { makeMcRunner, type McCompletionRecord, type McReadContext, type McRunner } from "./mc";
+import { handleApi } from "./api";
+import { deps } from "./test-helpers";
+
+function quote(value: string): string {
+  return `'${value.replaceAll("'", "'\\''")}'`;
+}
+
+interface Fixture {
+  root: string;
+  bin: string;
+  file(name: string): string;
+}
+
+async function fixture(script: string, body: (value: Fixture) => Promise<void>): Promise<void> {
+  const root = mkdtempSync(join(tmpdir(), "mc-read-deadline-"));
+  const bin = join(root, "mc-stub");
+  writeFileSync(bin, `#!/bin/sh\ncd ${quote(root)} || exit 9\n${script}\n`, { mode: 0o755 });
+  try {
+    await body({ root, bin, file: (name) => join(root, name) });
+  } finally {
+    writeFileSync(join(root, "release"), "release\n");
+    for (const name of ["child.pid", "parent.pid"]) {
+      const path = join(root, name);
+      if (!existsSync(path)) continue;
+      const pid = Number(readFileSync(path, "utf8").trim());
+      if (!Number.isInteger(pid) || pid <= 0) continue;
+      try {
+        process.kill(pid, "SIGKILL");
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ESRCH") throw error;
+      }
+    }
+    rmSync(root, { recursive: true, force: true });
+  }
+}
+
+async function until(condition: () => boolean, message: string): Promise<void> {
+  const deadline = performance.now() + 3000;
+  while (!condition()) {
+    if (performance.now() >= deadline) throw new Error(message);
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+}
+
+async function settles<T>(pending: Promise<T>): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      pending,
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => reject(new Error("The read did not complete.")), 3000);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function scoped(runner: McRunner, signal: AbortSignal, deadlineUnixMs = Date.now() + 10000): McRunner {
+  if (!runner.withReadContext) throw new Error("The runner does not expose the read context.");
+  return runner.withReadContext({ signal, deadlineUnixMs });
+}
+
+function errorCode(result: Awaited<ReturnType<McRunner["run"]>>): unknown {
+  return (result.json?.error as Record<string, unknown> | undefined)?.code;
+}
+
+function alive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ESRCH") return false;
+    throw error;
+  }
+}
+
+const queueStub = `
+for argument do project="$argument"; done
+printf '%s\\n' "$project" >> calls
+if [ "$project" = first ]; then
+  : > first-started
+  while [ ! -f release ]; do sleep 0.02; done
+fi
+printf '{"project":"%s"}\\n' "$project"
+`;
+
+const partialStatus = {
+  complete: false,
+  observed_at: "2026-10-11T20:00:00.000000123Z",
+  conditions: [],
+  connections: [],
+  availability: { observed_at: "", available: false, can_commit: false },
+  viewers: {
+    agentsview: { url: "", state: "unavailable", reason: "The viewer is unavailable." },
+    wiki: { url: "", projects: {} },
+  },
+};
+
+describe("The command read deadline", () => {
+  test("Each GET request receives its own context without changing shared dependencies", async () => {
+    const contexts: McReadContext[] = [];
+    const mc: McRunner = {
+      run: async () => ({ code: 0, json: { plain: true }, stderr: "" }),
+      withReadContext(context) {
+        contexts.push(context);
+        return { run: async () => ({ code: 0, json: { scoped: true }, stderr: "" }) };
+      },
+    };
+    const shared = deps({ mc });
+    const controller = new AbortController();
+    const first = new Request("http://localhost/api/sessions", { signal: controller.signal });
+    const second = new Request("http://localhost/api/sessions");
+    const before = Date.now();
+    expect(await (await handleApi(first, new URL(first.url), shared))?.json()).toEqual({ scoped: true });
+    expect(await (await handleApi(second, new URL(second.url), shared))?.json()).toEqual({ scoped: true });
+    expect(shared.mc).toBe(mc);
+    expect(contexts).toHaveLength(2);
+    expect(contexts[0]!.signal).toBe(first.signal);
+    expect(contexts[1]!.signal).toBe(second.signal);
+    expect(contexts[0]!.deadlineUnixMs).toBeGreaterThanOrEqual(before + 15000);
+    expect(contexts[0]!.deadlineUnixMs).toBeLessThanOrEqual(Date.now() + 15000);
+    controller.abort();
+    expect(contexts[0]!.signal.aborted).toBe(true);
+    expect(contexts[1]!.signal.aborted).toBe(false);
+    const post = new Request("http://localhost/api/no-such-route", { method: "POST" });
+    await handleApi(post, new URL(post.url), shared);
+    expect(contexts).toHaveLength(2);
+  });
+
+  test("A scoped read carries the absolute deadline and reports its complete duration", async () => {
+    await fixture(`printf '%s\\n' "$@" > arguments\nprintf '{"tasks":[]}'`, async (value) => {
+      const records: McCompletionRecord[] = [];
+      const runner = makeMcRunner(value.bin, { onComplete: (record) => records.push(record) });
+      const controller = new AbortController();
+      const deadline = Date.now() + 10000;
+      const result = await scoped(runner, controller.signal, deadline).run(["task", "list"]);
+      expect(result.code).toBe(0);
+      expect(result.json).toEqual({ tasks: [] });
+      expect(readFileSync(value.file("arguments"), "utf8").trim().split("\n")).toEqual([
+        "__read", "--deadline-unix-ms", String(deadline), "--", "task", "list",
+      ]);
+      expect(records).toHaveLength(1);
+      const record = records[0]!;
+      expect(record.outcome).toBe("completed");
+      expect(record.code).toBe(0);
+      expect(record.pid).toBeGreaterThan(0);
+      expect(record.spawnedAtUnixMs).not.toBeNull();
+      expect(record.exitObservedAtUnixMs).not.toBeNull();
+      expect(record.startedAtUnixMs).toBeLessThanOrEqual(record.spawnedAtUnixMs!);
+      expect(record.spawnedAtUnixMs!).toBeLessThanOrEqual(record.exitObservedAtUnixMs!);
+      expect(record.exitObservedAtUnixMs!).toBeLessThanOrEqual(record.completedAtUnixMs);
+      expect(record.elapsedMs).toBeGreaterThanOrEqual(0);
+      expect(record.queueMs).toBeGreaterThanOrEqual(0);
+      expect(record.elapsedMs).toBeGreaterThanOrEqual(record.queueMs);
+    });
+  });
+
+  test("An aborted read in a shared queue creates no process", async () => {
+    await fixture(queueStub, async (value) => {
+      const records: McCompletionRecord[] = [];
+      const runner = makeMcRunner(value.bin, { maxConcurrentReads: 1, onComplete: (record) => records.push(record) });
+      const firstController = new AbortController();
+      const secondController = new AbortController();
+      const first = scoped(runner, firstController.signal).run(["task", "list", "--project", "first"]);
+      try {
+        await until(() => existsSync(value.file("first-started")), "The first read did not start.");
+        const second = scoped(runner, secondController.signal).run(["task", "list", "--project", "second"]);
+        secondController.abort();
+        const result = await settles(second);
+        expect(result.code).toBe(2);
+        expect(errorCode(result)).toBe("request-cancelled");
+        expect(readFileSync(value.file("calls"), "utf8")).toBe("first\n");
+        const cancelled = records.find((record) => record.outcome === "cancelled");
+        expect(cancelled).toBeDefined();
+        expect(cancelled!.pid).toBeNull();
+        expect(cancelled!.spawnedAtUnixMs).toBeNull();
+        expect(cancelled!.exitObservedAtUnixMs).toBeNull();
+        writeFileSync(value.file("release"), "release\n");
+        expect((await first).code).toBe(0);
+      } finally {
+        writeFileSync(value.file("release"), "release\n");
+        firstController.abort();
+        secondController.abort();
+        await settles(first);
+      }
+    });
+  });
+
+  test("A read that expires in a shared queue creates no process", async () => {
+    await fixture(queueStub, async (value) => {
+      const records: McCompletionRecord[] = [];
+      const runner = makeMcRunner(value.bin, { maxConcurrentReads: 1, onComplete: (record) => records.push(record) });
+      const firstController = new AbortController();
+      const secondController = new AbortController();
+      const first = scoped(runner, firstController.signal).run(["task", "list", "--project", "first"]);
+      try {
+        await until(() => existsSync(value.file("first-started")), "The first read did not start.");
+        const result = await settles(scoped(runner, secondController.signal, Date.now() + 50)
+          .run(["task", "list", "--project", "second"]));
+        expect(result.code).toBe(2);
+        expect(errorCode(result)).toBe("deadline-exceeded");
+        expect(readFileSync(value.file("calls"), "utf8")).toBe("first\n");
+        const expired = records.find((record) => record.outcome === "deadline");
+        expect(expired).toBeDefined();
+        expect(expired!.pid).toBeNull();
+        expect(expired!.spawnedAtUnixMs).toBeNull();
+        expect(expired!.exitObservedAtUnixMs).toBeNull();
+        expect(expired!.queueMs).toBeGreaterThan(0);
+        writeFileSync(value.file("release"), "release\n");
+        expect((await first).code).toBe(0);
+      } finally {
+        writeFileSync(value.file("release"), "release\n");
+        firstController.abort();
+        secondController.abort();
+        await settles(first);
+      }
+    });
+  });
+
+  test("Cancellation stops the active process and its child before completion", async () => {
+    await fixture(`echo $$ > parent.pid\nsleep 30 &\necho $! > child.pid\nwait\nprintf '{"tasks":[]}'`, async (value) => {
+      const records: McCompletionRecord[] = [];
+      const runner = makeMcRunner(value.bin, { onComplete: (record) => records.push(record) });
+      const controller = new AbortController();
+      const pending = scoped(runner, controller.signal).run(["task", "list"]);
+      try {
+        await until(() => existsSync(value.file("child.pid")), "The read child did not start.");
+        const child = Number(readFileSync(value.file("child.pid"), "utf8").trim());
+        const parent = Number(readFileSync(value.file("parent.pid"), "utf8").trim());
+        expect(alive(child)).toBe(true);
+        controller.abort();
+        const result = await settles(pending);
+        expect(result.code).toBe(2);
+        expect(errorCode(result)).toBe("request-cancelled");
+        await until(() => !alive(child) && !alive(parent), "The read process group still exists.");
+        expect(records).toHaveLength(1);
+        expect(records[0]!.outcome).toBe("cancelled");
+        expect(records[0]!.pid).toBe(parent);
+        expect(records[0]!.exitObservedAtUnixMs).not.toBeNull();
+      } finally {
+        controller.abort();
+      }
+    });
+  });
+
+  test("A cancelled active read retains its admission slot until the absolute deadline", async () => {
+    await fixture(queueStub, async (value) => {
+      const records: McCompletionRecord[] = [];
+      const runner = makeMcRunner(value.bin, { maxConcurrentReads: 1, onComplete: (record) => records.push(record) });
+      const firstController = new AbortController();
